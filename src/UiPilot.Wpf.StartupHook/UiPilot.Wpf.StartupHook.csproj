<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>UiPilot.Wpf.StartupHook</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>DOTNET_STARTUP_HOOKS assembly that starts UiPilot.Wpf without editing the target app.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Wpf\UiPilot.Wpf.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <SetTargetFramework>TargetFramework=net8.0-windows</SetTargetFramework>
      <AdditionalProperties>CopyLocalLockFileAssemblies=true;TargetFramework=net8.0-windows</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPilotPayload" AfterTargets="Build">
    <PropertyGroup>
      <_WpfOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.Wpf\bin\$(Configuration)\net8.0-windows'))</_WpfOut>
    </PropertyGroup>
    <ItemGroup>
      <_Copy Include="$(_WpfOut)\*.dll"
             Exclude="$(_WpfOut)\UiPilot.Wpf.StartupHook.dll" />
      <_Copy Include="$(_WpfOut)\UiPilot.Wpf.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_Copy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_Copy)' != ''" />
  </Target>

</Project>
