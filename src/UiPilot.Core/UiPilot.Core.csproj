<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UiPilot</RootNamespace>
    <AssemblyName>UiPilot.Core</AssemblyName>
    <PackageId>UiPilot.Core</PackageId>
    <Description>Shared MCP-over-pipe protocol, discovery, and UI-backend contracts for UiPilot (WPF and Avalonia).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UiPilot.Wpf" />
    <InternalsVisibleTo Include="UiPilot.Avalonia" />
    <InternalsVisibleTo Include="UiPilot.Cli" />
    <InternalsVisibleTo Include="UiPilot.Tests" />
  </ItemGroup>

</Project>
