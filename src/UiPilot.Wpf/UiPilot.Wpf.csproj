<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>UiPilot.Wpf</RootNamespace>
    <AssemblyName>UiPilot.Wpf</AssemblyName>
    <PackageId>UiPilot.Wpf</PackageId>
    <Description>In-process WPF automation for AI agents: visual tree query, bindings, screenshots, synthetic input, exposed over MCP on a named pipe.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Core\UiPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UiPilot.Tests" />
  </ItemGroup>

</Project>
