<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>UiPilot.WinForms.StartupHook</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>DOTNET_STARTUP_HOOKS assembly that starts UiPilot.WinForms without editing the target app.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.WinForms\UiPilot.WinForms.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <SetTargetFramework>TargetFramework=net8.0-windows</SetTargetFramework>
      <AdditionalProperties>CopyLocalLockFileAssemblies=true;TargetFramework=net8.0-windows</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPilotPayload" AfterTargets="Build">
    <PropertyGroup>
      <_WinFormsOutBase>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.WinForms\bin\$(Configuration)\net8.0-windows'))</_WinFormsOutBase>
      <_WinFormsOut Condition="'$(RuntimeIdentifier)' == ''">$(_WinFormsOutBase)</_WinFormsOut>
      <_WinFormsOut Condition="'$(RuntimeIdentifier)' != ''">$(_WinFormsOutBase)\$(RuntimeIdentifier)</_WinFormsOut>
    </PropertyGroup>
    <ItemGroup>
      <_Copy Include="$(_WinFormsOut)\*.dll"
             Exclude="$(_WinFormsOut)\UiPilot.WinForms.StartupHook.dll" />
      <_Copy Include="$(_WinFormsOut)\UiPilot.WinForms.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_Copy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_Copy)' != ''" />
  </Target>

</Project>
