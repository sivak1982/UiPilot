<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UiPilot.Cli</RootNamespace>
    <AssemblyName>UiPilot.Cli</AssemblyName>
    <!-- When packaged as a dotnet tool the invocable command is still 'uipilot'. -->
    <ToolCommandName>uipilot</ToolCommandName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- MCP stdio servers must never write to stdout except protocol frames. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Core\UiPilot.Core.csproj" />
    <ProjectReference Include="..\UiPilot.Avalonia.StartupHook\UiPilot.Avalonia.StartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\UiPilot.Wpf.StartupHook\UiPilot.Wpf.StartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Ship startup hooks under hooks/avalonia and hooks/wpf next to the CLI. -->
  <Target Name="CopyStartupHooks" AfterTargets="Build">
    <PropertyGroup>
      <_AvaloniaHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.Avalonia.StartupHook\bin\$(Configuration)\net8.0'))</_AvaloniaHookOut>
      <_WpfHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.Wpf.StartupHook\bin\$(Configuration)\net8.0'))</_WpfHookOut>
      <_HooksAvalonia>$(OutputPath)hooks\avalonia\</_HooksAvalonia>
      <_HooksWpf>$(OutputPath)hooks\wpf\</_HooksWpf>
    </PropertyGroup>
    <MakeDir Directories="$(_HooksAvalonia);$(_HooksWpf)" />
    <ItemGroup>
      <_AvaloniaHookFiles Include="$(_AvaloniaHookOut)\*.dll" />
      <_AvaloniaHookFiles Include="$(_AvaloniaHookOut)\*.json" />
      <_WpfHookFiles Include="$(_WpfHookOut)\*.dll" />
      <_WpfHookFiles Include="$(_WpfHookOut)\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_AvaloniaHookFiles)" DestinationFolder="$(_HooksAvalonia)" SkipUnchangedFiles="true" Condition="'@(_AvaloniaHookFiles)' != ''" />
    <Copy SourceFiles="@(_WpfHookFiles)" DestinationFolder="$(_HooksWpf)" SkipUnchangedFiles="true" Condition="'@(_WpfHookFiles)' != ''" />
  </Target>

</Project>
