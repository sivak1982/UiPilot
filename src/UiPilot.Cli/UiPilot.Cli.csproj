<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UiPilot.Cli</RootNamespace>
    <AssemblyName>UiPilot.Cli</AssemblyName>
    <!-- When packaged as a dotnet tool the invocable command is still 'uipilot'. -->
    <ToolCommandName>uipilot</ToolCommandName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- MCP stdio servers must never write to stdout except protocol frames. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <InternalsVisibleTo Include="UiPilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Core\UiPilot.Core.csproj" />
    <ProjectReference Include="..\UiPilot.Client\UiPilot.Client.csproj" />
    <ProjectReference Include="..\UiPilot.StartupHook\UiPilot.StartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Compiled into UiPilot.Client so product tests can use lifecycle/transport without
       referencing this executable host. -->
  <ItemGroup>
    <Compile Remove="ConnectionManager.cs" />
    <Compile Remove="PilotCliException.cs" />
    <Compile Remove="Discovery\**\*.cs" />
    <Compile Remove="Pipe\**\*.cs" />
    <Compile Remove="Process\**\*.cs" />
  </ItemGroup>

  <!-- Ship the generic startup hook and its isolated adapter payloads next to the CLI. -->
  <Target Name="CopyStartupHooks" AfterTargets="Build">
    <PropertyGroup>
      <_HookRidSuffix Condition="'$(RuntimeIdentifier)' != ''">\$(RuntimeIdentifier)</_HookRidSuffix>
      <_GenericHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.StartupHook\bin\$(Configuration)\net8.0$(_HookRidSuffix)'))</_GenericHookOut>
      <_HooksOut>$(OutputPath)hooks\</_HooksOut>
    </PropertyGroup>
    <MakeDir Directories="$(_HooksOut)" />
    <ItemGroup>
      <_GenericHookFiles Include="$(_GenericHookOut)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_GenericHookFiles)"
      DestinationFiles="@(_GenericHookFiles->'$(_HooksOut)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_GenericHookFiles)' != ''" />
  </Target>

  <!-- Build places hooks under TargetDir; publish must preserve that sibling layout because
       StartupHookLocator resolves hooks relative to the installed CLI. -->
  <Target Name="CopyStartupHooksToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedStartupHookFiles Include="$(TargetDir)hooks\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_PublishedStartupHookFiles)"
      DestinationFiles="@(_PublishedStartupHookFiles->'$(PublishDir)hooks\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_PublishedStartupHookFiles)' != ''" />
  </Target>

</Project>
