<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>UiPilot.Avalonia.StartupHook</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>DOTNET_STARTUP_HOOKS assembly that starts UiPilot.Avalonia without editing the target app.</Description>
  </PropertyGroup>

  <!-- Build Avalonia adapter with lock-file assemblies so MCP deps land in its output. -->
  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Avalonia\UiPilot.Avalonia.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <AdditionalProperties>CopyLocalLockFileAssemblies=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPilotPayload" AfterTargets="Build">
    <PropertyGroup>
      <_AvaloniaOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.Avalonia\bin\$(Configuration)\net8.0'))</_AvaloniaOut>
    </PropertyGroup>
    <ItemGroup>
      <_Copy Include="$(_AvaloniaOut)\*.dll"
             Exclude="$(_AvaloniaOut)\Avalonia*.dll;$(_AvaloniaOut)\MicroCom*.dll;$(_AvaloniaOut)\Tmds*.dll;$(_AvaloniaOut)\HarfBuzz*.dll;$(_AvaloniaOut)\SkiaSharp*.dll;$(_AvaloniaOut)\UiPilot.Avalonia.StartupHook.dll" />
      <_Copy Include="$(_AvaloniaOut)\UiPilot.Avalonia.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_Copy)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_Copy)' != ''" />
  </Target>

</Project>
