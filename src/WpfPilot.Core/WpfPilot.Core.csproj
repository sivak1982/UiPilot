<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <RootNamespace>WpfPilot</RootNamespace>
    <AssemblyName>WpfPilot.Core</AssemblyName>
    <PackageId>WpfPilot.Core</PackageId>
    <Description>Shared protocol, pipe transport, and UI-backend contracts for WpfPilot / AvaloniaPilot.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfPilot" />
    <InternalsVisibleTo Include="AvaloniaPilot" />
    <InternalsVisibleTo Include="WpfPilot.Tests" />
  </ItemGroup>

</Project>
