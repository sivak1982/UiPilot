<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Core\UiPilot.Core.csproj" />
    <ProjectReference Include="..\UiPilot.Avalonia.StartupHook\UiPilot.Avalonia.StartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\UiPilot.Wpf.StartupHook\UiPilot.Wpf.StartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Lifecycle/transport implementation is shared by the MCP host and typed client.
       Keeping it in this assembly prevents product tests from depending on the CLI executable. -->
  <ItemGroup>
    <Compile Include="..\UiPilot.Cli\ConnectionManager.cs" Link="Infrastructure\ConnectionManager.cs" />
    <Compile Include="..\UiPilot.Cli\PilotCliException.cs" Link="Infrastructure\PilotCliException.cs" />
    <Compile Include="..\UiPilot.Cli\Discovery\*.cs" Link="Infrastructure\Discovery\%(Filename)%(Extension)" />
    <Compile Include="..\UiPilot.Cli\Pipe\*.cs" Link="Infrastructure\Pipe\%(Filename)%(Extension)" />
    <Compile Include="..\UiPilot.Cli\Process\*.cs" Link="Infrastructure\Process\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyStartupHooks" AfterTargets="Build">
    <PropertyGroup>
      <_AvaloniaHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.Avalonia.StartupHook\bin\$(Configuration)\net8.0'))</_AvaloniaHookOut>
      <_WpfHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.Wpf.StartupHook\bin\$(Configuration)\net8.0'))</_WpfHookOut>
      <_HooksAvalonia>$(OutputPath)hooks\avalonia\</_HooksAvalonia>
      <_HooksWpf>$(OutputPath)hooks\wpf\</_HooksWpf>
    </PropertyGroup>
    <MakeDir Directories="$(_HooksAvalonia);$(_HooksWpf)" />
    <ItemGroup>
      <_AvaloniaHookFiles Include="$(_AvaloniaHookOut)\*.dll;$(_AvaloniaHookOut)\*.json" />
      <_WpfHookFiles Include="$(_WpfHookOut)\*.dll;$(_WpfHookOut)\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_AvaloniaHookFiles)" DestinationFolder="$(_HooksAvalonia)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WpfHookFiles)" DestinationFolder="$(_HooksWpf)" SkipUnchangedFiles="true" />
  </Target>

</Project>
