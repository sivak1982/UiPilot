<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiPilot.Core\UiPilot.Core.csproj" />
    <ProjectReference Include="..\UiPilot.StartupHook\UiPilot.StartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Lifecycle/transport implementation is shared by the MCP host and typed client.
       Keeping it in this assembly prevents product tests from depending on the CLI executable. -->
  <ItemGroup>
    <Compile Include="..\UiPilot.Cli\ConnectionManager.cs" Link="Infrastructure\ConnectionManager.cs" />
    <Compile Include="..\UiPilot.Cli\PilotCliException.cs" Link="Infrastructure\PilotCliException.cs" />
    <Compile Include="..\UiPilot.Cli\Discovery\*.cs" Link="Infrastructure\Discovery\%(Filename)%(Extension)" />
    <Compile Include="..\UiPilot.Cli\Pipe\*.cs" Link="Infrastructure\Pipe\%(Filename)%(Extension)" />
    <Compile Include="..\UiPilot.Cli\Process\*.cs" Link="Infrastructure\Process\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyStartupHooks" AfterTargets="Build">
    <PropertyGroup>
      <_HookRidSuffix Condition="'$(RuntimeIdentifier)' != ''">\$(RuntimeIdentifier)</_HookRidSuffix>
      <_GenericHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\UiPilot.StartupHook\bin\$(Configuration)\net8.0$(_HookRidSuffix)'))</_GenericHookOut>
      <_HooksOut>$(OutputPath)hooks\</_HooksOut>
    </PropertyGroup>
    <MakeDir Directories="$(_HooksOut)" />
    <ItemGroup>
      <_GenericHookFiles Include="$(_GenericHookOut)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_GenericHookFiles)"
      DestinationFiles="@(_GenericHookFiles->'$(_HooksOut)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_GenericHookFiles)' != ''" />
  </Target>

</Project>
