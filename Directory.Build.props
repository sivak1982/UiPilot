<Project>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow net*-windows TFMs to restore/build on Linux CI/agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      The CLI is launched as an MCP stdio server via `dotnet run`. MSBuild/NuGet write
      warnings to stdout, which corrupts the JSON-RPC stream the MCP client reads and
      surfaces as "Connection closed / failed during live tool discovery". NU1507 fires
      because the ambient NuGet.config defines multiple sources under central package
      management; it is benign here, so suppress it to keep the MCP stdout channel clean.
    -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Company>UiPilot</Company>
    <Product>UiPilot</Product>
    <Authors>UiPilot</Authors>
    <Copyright>Copyright (c) UiPilot</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sivak1982/UiPilot</RepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
