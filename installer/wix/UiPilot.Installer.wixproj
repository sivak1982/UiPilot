<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <SuppressIces>ICE38;ICE43;ICE57;ICE61;ICE64;ICE91</SuppressIces>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PayloadWxs)" Condition="'$(PayloadWxs)' != ''" />
  </ItemGroup>
</Project>
