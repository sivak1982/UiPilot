<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaSampleApp"
        x:Class="AvaloniaSampleApp.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="UiPilot.Avalonia Sample"
        Width="420" Height="240">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="UiPilot.Avalonia Sample" FontSize="20" FontWeight="Bold" />
    <TextBox Name="NameBox" Watermark="Your name" Text="{Binding Name}" />
    <Button Name="GreetButton" Content="Greet" Command="{Binding GreetCommand}" />
    <TextBlock Name="GreetingText" Text="{Binding Greeting}" />
  </StackPanel>
</Window>
