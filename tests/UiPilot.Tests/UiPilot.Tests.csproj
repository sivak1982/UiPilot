<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UiPilot.Core\UiPilot.Core.csproj" />
    <ProjectReference Include="..\..\src\UiPilot.Cli\UiPilot.Cli.csproj" />
    <ProjectReference Include="..\..\src\UiPilot.Client\UiPilot.Client.csproj" />
    <ProjectReference Include="..\..\samples\AvaloniaSampleApp\AvaloniaSampleApp.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\samples\WinFormsSampleApp\WinFormsSampleApp.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Product test projects receive these files from the future UiPilot.Client package.
       This repository test copies them explicitly to validate zero-edit startup hooks. -->
  <Target Name="CopyClientTestStartupHooks" AfterTargets="Build">
    <PropertyGroup>
      <_AvaloniaHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\UiPilot.Avalonia.StartupHook\bin\$(Configuration)\net8.0'))</_AvaloniaHookOut>
      <_WpfHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\UiPilot.Wpf.StartupHook\bin\$(Configuration)\net8.0'))</_WpfHookOut>
      <_WinFormsHookOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\UiPilot.WinForms.StartupHook\bin\$(Configuration)\net8.0'))</_WinFormsHookOut>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)hooks\avalonia;$(OutputPath)hooks\wpf;$(OutputPath)hooks\winforms" />
    <ItemGroup>
      <_ClientAvaloniaHookFiles Include="$(_AvaloniaHookOut)\*.dll;$(_AvaloniaHookOut)\*.json" />
      <_ClientWpfHookFiles Include="$(_WpfHookOut)\*.dll;$(_WpfHookOut)\*.json" />
      <_ClientWinFormsHookFiles Include="$(_WinFormsHookOut)\*.dll;$(_WinFormsHookOut)\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ClientAvaloniaHookFiles)" DestinationFolder="$(OutputPath)hooks\avalonia" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ClientWpfHookFiles)" DestinationFolder="$(OutputPath)hooks\wpf" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ClientWinFormsHookFiles)" DestinationFolder="$(OutputPath)hooks\winforms" SkipUnchangedFiles="true" />
  </Target>

</Project>
